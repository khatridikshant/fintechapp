  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"code\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "journal_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"journal_entries\" (\"id\" TEXT NOT NULL, \"date\" INTEGER NOT NULL, \"description\" TEXT NOT NULL, \"reference\" TEXT NULL, \"currency\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "journal_lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"journal_lines\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"journal_entry_id\" TEXT NOT NULL, \"account_id\" TEXT NOT NULL, \"debit_minor_units\" INTEGER NOT NULL DEFAULT 0, \"credit_minor_units\" INTEGER NOT NULL DEFAULT 0, \"currency\" TEXT NOT NULL, CHECK (debit_minor_units >= 0 AND credit_minor_units >= 0), CHECK ((debit_minor_units > 0 AND credit_minor_units = 0) OR (credit_minor_units > 0 AND debit_minor_units = 0)), FOREIGN KEY (journal_entry_id) REFERENCES journal_entries(id), FOREIGN KEY (account_id) REFERENCES accounts(id));"
        }
      ]
    },
    {
      "name": "document_sequences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"document_sequences\" (\"document_type\" TEXT NOT NULL, \"fiscal_year_label\" TEXT NOT NULL, \"last_sequence\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"document_type\", \"fiscal_year_label\"), CHECK (last_sequence >= 0));"
        }
      ]
    },
    {
      "name": "customers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"customers\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"pan_number\" TEXT NULL, \"phone\" TEXT NULL, \"address\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (trim(name) <> ''));"
        }
      ]
    }
